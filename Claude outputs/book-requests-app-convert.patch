diff --git a/scripts/app_seed.py b/scripts/app_seed.py
new file mode 100644
index 0000000..67870e4
--- /dev/null
+++ b/scripts/app_seed.py
@@ -0,0 +1,59 @@
+"""The manuscript into a new book, the way the Authoring Assistant does it.
+
+    python3 scripts/app_seed.py <authoring-assistant checkout> <book folder> <file>...
+
+Word files go through the app's own converter (app/convert.py: the same
+pandoc flags, the Word file's own name for the chapter, pictures in
+assets/<chapter name>/), and each chapter gets its front-page line from the
+app's own contents.py. So a chapter set up here and the same chapter brought
+in again later from the app are the same file, and the app replaces it
+instead of adding a second copy. Markdown files are copied under their own
+name. Prints the chapters made, as JSON, in order.
+"""
+
+import json
+import os
+import shutil
+import sys
+
+aa, book, files = sys.argv[1], sys.argv[2], sys.argv[3:]
+sys.path.insert(0, os.path.abspath(aa))
+from app import contents, convert  # noqa: E402
+
+chapters_dir = os.path.join(book, "chapters")
+index_path = os.path.join(book, "index.md")
+made = []
+
+for path in files:
+    base = os.path.basename(path)
+    if base.lower().endswith(".docx"):
+        name = convert.suggest_name(path)
+        problem = convert.name_problem(name) or convert.destination_problem(chapters_dir, name)
+        if problem:
+            sys.exit(f"{base}: {problem}")
+        result = convert.convert(path, name, chapters_dir)
+        try:
+            convert.save(result, chapters_dir)
+        finally:
+            convert.discard(result)
+        text = result["text"]
+    else:
+        name = base if base.lower().endswith((".md", ".markdown")) else base + ".md"
+        problem = convert.name_problem(name) or convert.destination_problem(chapters_dir, name)
+        if problem:
+            sys.exit(f"{base}: {problem}")
+        shutil.copyfile(path, os.path.join(chapters_dir, name))
+        with open(os.path.join(chapters_dir, name), encoding="utf-8", errors="replace") as fh:
+            text = fh.read()
+
+    chapter_path = f"chapters/{name}"
+    title = contents.chapter_title(text, name)
+    with open(index_path, encoding="utf-8", newline="") as fh:
+        index = fh.read()
+    new, _why = contents.add_line(index, chapter_path, title)
+    if new is not None:
+        with open(index_path, "w", encoding="utf-8", newline="") as fh:
+            fh.write(new)
+    made.append({"path": chapter_path, "title": title})
+
+print(json.dumps(made))
